# Dify 平台配置
# 填写你的 Dify 服务器地址（局域网IP或域名），不要用 localhost
# 如果是 HTTPS 自签名证书（内网常见），请同时设置 DIFY_ALLOW_INSECURE=true
DIFY_BASE_URL=https://10.1.7.141:8200/v1
DIFY_API_KEY=app-your-api-key-here
DIFY_ALLOW_INSECURE=true

# 服务端口
PORT=4000

# 数据库（SQLite 路径）
DB_PATH=./data/maintenance.db

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 前端构建产物（生产模式，仅 start-prod.bat 使用）
STATIC_DIR=../client/dist
